.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Dependency Lock Files ---
# Arquivos de lock grandes que consomem muitos tokens e raramente são necessários para lógica
uv.lock
poetry.lock
Pipfile.lock
# Caso existam dependencias node legadas/futuras
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Project Specific Logs & Output ---
# Logs na raiz ou em subpastas
*.log
log_*.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
celerybeat-schedule

# --- Large/Binary Assets ---
