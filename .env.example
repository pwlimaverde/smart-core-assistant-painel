# Variáveis de ambiente - exemplo (não versionar valores reais)

# --- Trello API ---
# Chave de API obtida em https://trello.com/app-key
TRELLO_API_KEY=

# Segredo da API (não é usado para chamadas REST comuns, opcional)
TRELLO_API_SECRET=

# Token de acesso pessoal (gerado com escopos read,write)
TRELLO_TOKEN=

# URL pública para receber webhooks do Trello (opcional)
# Exemplo: http://localhost:8000/api/trello_sync/webhook/
TRELLO_WEBHOOK_CALLBACK_URL=

# Habilitação de webhooks do Trello: true|false|auto
# Padrão recomendado: auto (não registra se URL for local)
TRELLO_ENABLE_WEBHOOKS=auto

# --- Django / Aplicação ---
# Hosts permitidos (se vazio, usa defaults no DEBUG)
DJANGO_ALLOWED_HOSTS=
# Chave secreta do Django (defina localmente)
SECRET_KEY_DJANGO=

# --- Banco de Dados PostgreSQL ---
# Observação: para uso local com Docker, execute o compose em
# ambiente_base_dados/ e use as variáveis abaixo.
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_DB=smart_core_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
# SSL no Postgres (disable por padrão para ambiente local)
POSTGRES_SSLMODE=disable
# Tempo de espera para conexão (segundos)
POSTGRES_CONNECT_TIMEOUT=5

# --- Redis ---
# Configure para cache e django-q quando necessário.
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=

# --- Fallback local sem Postgres ---
# Defina "1" para usar SQLite local e iniciar sem Docker.
USE_LOCAL_SQLITE=

# --- Google Credentials ---
# Caminho para credenciais, se necessário para serviços Google.
GOOGLE_APPLICATION_CREDENTIALS=

# --- ClickUp API ---
# OAuth App (ClickUp)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# Nome do app (apenas informativo)
CLICKUP_APP_NAME=
# URL de redirect registrada no app (ajuste conforme sua rota)
# Ex.: http://127.0.0.1:8000/integrations/clickup/callback/
CLICKUP_OAUTH_REDIRECT_URI=
# Opcional: Workspace ID (team_id) para limitar escopo
CLICKUP_TEAM_ID=
# Opcional: token pessoal (pk_...) para testes
CLICKUP_PERSONAL_TOKEN=
# Token OAuth obtido via troca do "code" por access token
CLICKUP_OAUTH_ACCESS_TOKEN=

# Nome do Space alvo onde serão criados Folders/Lists
# Exemplo recomendado: smart-core-assistant
CLICKUP_APP_ESPACO=

# --- ngrok ---
# Authtoken do ngrok (necessário para iniciar túneis autenticados)
NGROK_AUTHTOKEN=
# Caminho absoluto do binário ngrok (se não estiver no PATH)
NGROK_PATH=