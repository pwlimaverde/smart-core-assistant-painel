## Backend Environment Variables (example - do not commit secrets)
#
# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
# NUNCA coloque segredos reais neste arquivo.

# Django
SECRET_KEY_DJANGO=changeme-in-.env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,host.docker.internal

# Banco de dados
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_core_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (minutos)
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_MIN=60

# Serviços externos
EVOLUTION_API_URL=http://localhost:8080
OLLAMA_BASE_URL=http://192.168.3.127:11434

# Notion (integração)
# Configure seu token de integração e a página pai.
# Como obter o token: https://www.notion.so/my-integrations
# Como obter o page id: abra a página e copie a parte final do URL.
NOTION_TOKEN=changeme-in-.env
NOTION_PAGE_ID=changeme-in-.env

# CORS (origens permitidas para o frontend)
# Separe por vírgula, sem espaços
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# CSRF (opcional, geralmente inferido a partir de CORS_ALLOWED_ORIGINS)
# CSRF_TRUSTED_ORIGINS=https://localhost:4200,https://127.0.0.1:4200