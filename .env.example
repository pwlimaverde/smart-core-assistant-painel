# =====================================================
# Smart Core Assistant Painel - Configuração de Ambiente
# =====================================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env com valores reais!

# Nome do projeto no Docker (define o agrupamento no Docker Desktop)
COMPOSE_PROJECT_NAME=smartcore

# =====================================================
# DJANGO / APLICAÇÃO
# =====================================================
# Chave secreta do Django (OBRIGATÓRIO em produção)
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY_DJANGO=

# Modo debug (SEMPRE False em produção!)
DEBUG=False

# Hosts permitidos (separados por vírgula)
# Exemplo: painel.smartcoreassistant.com.br,localhost
DJANGO_ALLOWED_HOSTS=

# Domínio base para multi-tenant SaaS (habilita domínio + wildcard subdomínios)
# Exemplo: smartcoreassistant.com.br (aceita domínio e *.smartcoreassistant.com.br)
TENANT_BASE_DOMAIN=smartcoreassistant.com.br

# =====================================================
# BANCO DE DADOS POSTGRESQL
# =====================================================
# Configurações do PostgreSQL principal (SaaS core)
POSTGRES_HOST=smartcore_postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_core_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Porta publicada externamente (apenas para acesso direto, não usado em produção)
POSTGRES_PUBLISH_PORT=5438

# SSL no Postgres (prefer ou require em produção)
POSTGRES_SSLMODE=prefer

# Tempo de espera para conexão (segundos)
POSTGRES_CONNECT_TIMEOUT=10

# =====================================================
# REDIS (Cache & Celery Broker)
# =====================================================
REDIS_HOST=smartcore_redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Porta publicada externamente (apenas para acesso direto)
REDIS_PUBLISH_PORT=6384

# =====================================================
# CELERY (Processamento Assíncrono)
# =====================================================
# Número de workers concorrentes (ajuste conforme RAM disponível)
# Recomendado: 2-3 para 8GB RAM
CELERY_CONCURRENCY=3

# =====================================================
# CLOUDFLARE TUNNEL (Exposição Segura)
# =====================================================
# Token do túnel Cloudflare (OBRIGATÓRIO para produção)
# Obtenha em: Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# Protocolo do túnel (http2 recomendado)
CLOUDFLARE_TUNNEL_PROTOCOL=http2

# =====================================================
# INTEGRAÇÃO WHATSAPP (Evolution API)
# =====================================================
# URL da Evolution API (container ou externa)
EVOLUTION_API_URL=http://evolution_api:8080

# =====================================================
# INTELIGÊNCIA ARTIFICIAL (LLM)
# =====================================================
# OpenAI
OPENAI_API_KEY=

# Groq (alternativa rápida)
GROQ_API_KEY=

# Ollama (IA local - opcional)
OLLAMA_BASE_URL=http://ollama:11434

# xAI (opcional)
XAI_API_KEY=

# =====================================================
# FIREBASE (Remote Config para Prompts)
# =====================================================
# Caminho para credenciais do Firebase
GOOGLE_APPLICATION_CREDENTIALS=

# =====================================================
# EMAIL (SMTP)
# =====================================================
# Configuração SMTP (Brevo/Sendinblue recomendado)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@smartcoreassistant.com.br

# =====================================================
# INTEGRAÇÕES EXTERNAS (Opcionais)
# =====================================================

# --- Trello API ---
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_TOKEN=
TRELLO_WEBHOOK_CALLBACK_URL=
# Habilitação de webhooks: true|false|auto (auto não registra se URL for local)
TRELLO_ENABLE_WEBHOOKS=auto

# --- ClickUp API ---
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_APP_NAME=
CLICKUP_OAUTH_REDIRECT_URI=
CLICKUP_TEAM_ID=
CLICKUP_PERSONAL_TOKEN=
CLICKUP_OAUTH_ACCESS_TOKEN=
CLICKUP_APP_ESPACO=

# --- Notion API ---
NOTION_INTEGRATION_TOKEN=

# =====================================================
# MONITORAMENTO (Opcional)
# =====================================================
# Flower (monitoramento Celery)
FLOWER_USER=admin
FLOWER_PASSWORD=
FLOWER_PORT=5555

# =====================================================
# DESENVOLVIMENTO LOCAL (Ignorar em Produção)
# =====================================================
# Defina "1" para usar SQLite local (apenas desenvolvimento)
USE_LOCAL_SQLITE=

# ngrok (túnel para desenvolvimento)
NGROK_AUTHTOKEN=
NGROK_PATH=

# Docker Host remoto para scripts de gerenciamento
# Exemplo: ssh://user@servidor.com
SMART_CORE_DOCKER_HOST=

# SSH Hostinger (opcional, para acesso operacional)
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_USER=root
HOSTINGER_SSH_PORT=22
HOSTINGER_SSH_PASSWORD=
HOSTINGER_SSH_ALIAS=hostinger-root
HOSTINGER_SSH_IDENTITY_FILE=~/.ssh/id_hostinger_root
HOSTINGER_SSH_COMMAND=ssh hostinger-root
