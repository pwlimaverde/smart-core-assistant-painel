# Variáveis de ambiente - exemplo (não versionar valores reais)

# --- Trello API ---
# Chave de API obtida em https://trello.com/app-key
TRELLO_API_KEY=

# Segredo da API (não é usado para chamadas REST comuns, opcional)
TRELLO_API_SECRET=

# Token de acesso pessoal (gerado com escopos read,write)
TRELLO_TOKEN=

# URL pública para receber webhooks do Trello (opcional)
# Exemplo: http://localhost:8000/oraculo/webhook_trello/
TRELLO_WEBHOOK_CALLBACK_URL=