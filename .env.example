# =====================================================
# Smart Core Assistant Painel - Exemplo de Produção
# =====================================================
# Copie para .env.prod e preencha os segredos.
# Este arquivo contém SOMENTE variáveis em uso no sistema hoje.

# ===== DJANGO / SEGURANÇA =====
DJANGO_DEBUG=False
SECRET_KEY_DJANGO=<GERAR_CHAVE_FORTE_DJANGO>
DJANGO_ALLOWED_HOSTS=smartcoreassistant.com.br,.smartcoreassistant.com.br
CORS_ALLOWED_ORIGINS=https://smartcoreassistant.com.br,https://app.smartcoreassistant.com.br
CORS_ALLOW_ALL_ORIGINS=False
TENANT_BASE_DOMAIN=smartcoreassistant.com.br
PUBLIC_ASSET_BASE_URL=https://smartcoreassistant.com.br
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_MIN=60

# ===== BANCO / REDIS / CELERY =====
POSTGRES_DB=smart_core_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_HOST=smartcoreassistant_postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISH_HOST=127.0.0.1
POSTGRES_PUBLISH_PORT=5438
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=5
REDIS_HOST=smartcoreassistant_redis
REDIS_PORT=6379
# Defina sempre (produção). Em dev pode manter vazio, mas não recomendado.
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_PUBLISH_HOST=127.0.0.1
REDIS_PUBLISH_PORT=6384
CELERY_CONCURRENCY=3

# ===== INFRA / DEPLOY =====
CLOUDFLARE_TUNNEL_TOKEN=<CLOUDFLARE_TUNNEL_TOKEN>
CLOUDFLARE_TUNNEL_PROTOCOL=http2
FLOWER_USER=admin
FLOWER_PASSWORD=<FLOWER_PASSWORD>
FLOWER_PUBLISH_HOST=127.0.0.1
FLOWER_PORT=5555
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ===== APLICAÇÃO / INTEGRAÇÕES =====
# Chaves de LLM (OpenAI/Groq/Ollama etc.) são resolvidas via CoreSettings/TenantConfig.
# Por isso não entram neste arquivo de ambiente.
ENCRYPTION_KEY=<ENCRYPTION_KEY>
GOOGLE_APPLICATION_CREDENTIALS=
DISABLE_APP_SERVICES_INIT=0

# ===== WORKSPACE (ATENDIMENTO UNIFICADO) =====
# Feature flag global do módulo /workspace/ (chat + kanban).
# Default False — manter rollout gradual. Em produção, defina True quando
# pronto e use ATENDIMENTO_UNIFICADO_TENANT_SLUGS (CSV) para restringir.
ATENDIMENTO_UNIFICADO_ENABLED=False
# Lista CSV de slugs de tenants com acesso (vazio = todos os tenants).
# Ex.: ATENDIMENTO_UNIFICADO_TENANT_SLUGS=paulo-ecoprint,outro-tenant
ATENDIMENTO_UNIFICADO_TENANT_SLUGS=
# SSE (real-time). Mantenha False enquanto o Gunicorn estiver em worker
# sync (WSGI). Para ativar, troque o command para uvicorn.workers.UvicornWorker
# e mude esta flag para True.
ATENDIMENTO_UNIFICADO_SSE_ENABLED=False

# ===== EMAIL =====
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<EMAIL_HOST_USER>
EMAIL_HOST_PASSWORD=<EMAIL_HOST_PASSWORD>
DEFAULT_FROM_EMAIL=suporte@smartcoreassistant.com.br
