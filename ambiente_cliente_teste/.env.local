# ============================================
# SMART CORE ASSISTANT - AMBIENTE DE TESTE LOCAL
# ============================================
# Configuração para testar localmente usando Docker
# Host: 192.168.3.127 (servidor Docker local)
# ============================================
# 
# INSTRUÇÕES:
# 1. Renomeie este arquivo para .env
# 2. Execute: docker compose up -d
# ============================================

# === IDENTIFICAÇÃO DO TENANT ===
TENANT_SLUG=teste-local

# ============================================
# AMBIENTE CLIENTE (Sistema Django)
# ============================================

# === POSTGRESQL (SISTEMA DJANGO) ===
POSTGRES_DB=smartcore_cliente_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5436

# === REDIS (DJANGO CACHE/FILAS) ===
REDIS_PORT=6382

# ============================================
# AMBIENTE EVOLUTION (WhatsApp API)
# ============================================

# === POSTGRESQL (EVOLUTION API) ===
EVOLUTION_POSTGRES_DB=smartcore_evolution_db
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=evolution123
EVOLUTION_POSTGRES_PORT=5437

# === REDIS (EVOLUTION CACHE) ===
EVOLUTION_REDIS_PORT=6383

# === EVOLUTION API ===
EVOLUTION_API_KEY=chave-teste-local-smartcore-2024
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://192.168.3.127:8080

# === WEBHOOK ===
# Aponta para a aplicação Django local (192.168.3.90:8000)
# IMPORTANTE: O slug do tenant (ecoprint_teste) está na URL
WEBHOOK_CORE_URL=http://192.168.3.90:8000/sync/evolution/webhook/ecoprint_teste/

# === CACHE REDIS (Evolution) ===
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis_evolution:6379/0
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# === QR CODE ===
QRCODE_LIMIT=30
QRCODE_COLOR=#198754

# === LOGGING ===
LOG_LEVEL=WARN
LOG_COLOR=true
LOG_BAILEYS=error
