"""
Models do app notion_sync para integração com plataforma Notion.

Este módulo implementa a estrutura de dados necessária para sincronização
bidirecional entre models Django e databases/pages do Notion, seguindo
a arquitetura de shadow models e mapeamento de dados.
"""
import re
from datetime import datetime
from typing import Any, override

from django.apps import apps
from django.core.exceptions import ValidationError
from django.db import models
from django.utils import timezone

# Import pgvector for vector support
try:
    from pgvector.django import VectorExtension, VectorField
    PGVECTOR_AVAILABLE = True
except ImportError:
    PGVECTOR_AVAILABLE = False
    # Fallback for when pgvector is not available
    class VectorField(models.Field):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)

    class VectorExtension:
        pass


class NotionDatabaseConfig(models.Model):
    """
    Configuração de databases do Notion para sincronização.

    Centraliza informações sobre databases do Notion associados
    aos models Django, incluindo IDs, schema e mapeamentos.
    """

    slug: models.CharField = models.CharField(
        max_length=50,
        unique=True,
        help_text="Identificador único do database"
    )

    name: models.CharField = models.CharField(
        max_length=100,
        help_text="Nome descritivo do database"
    )

    django_model: models.CharField = models.CharField(
        max_length=100,
        help_text="Model Django associado (app.Model)"
    )

    notion_database_id: models.UUIDField = models.UUIDField(
        null=True,
        blank=True,
        help_text="ID do database no Notion"
    )

    notion_schema: models.JSONField = models.JSONField(
        default=dict,
        blank=True,
        help_text="Schema das propriedades do database Notion"
    )

    field_mappings: models.JSONField = models.JSONField(
        default=dict,
        blank=True,
        help_text="Mapeamento entre campos Django e Notion"
    )

    sync_enabled: models.BooleanField = models.BooleanField(
        default=True,
        help_text="Se sincronização está habilitada"
    )

    created_at: models.DateTimeField = models.DateTimeField(
        auto_now_add=True,
        help_text="Data de criação"
    )

    updated_at: models.DateTimeField = models.DateTimeField(
        auto_now=True,
        help_text="Data da última atualização"
    )

    class Meta:
        verbose_name = "Configuração de Database Notion"
        verbose_name_plural = "Configurações de Databases Notion"
        ordering = ["django_model"]
        db_table = "notion_database_config"
        indexes = [
            models.Index(fields=["django_model"]),
            models.Index(fields=["slug"]),
            models.Index(fields=["sync_enabled"]),
        ]

    def __str__(self) -> str:
        return f"{self.django_model} → {self.name}"

    def get_django_model_class(self) -> type[models.Model] | None:
        """
        Retorna a classe do model Django.

        Returns:
            Classe do model ou None se não encontrado.
        """
        try:
            app_label, model_name = self.django_model.split(".")
            return apps.get_model(app_label, model_name)
        except (ValueError, LookupError):
            return None

    def is_ready_for_sync(self) -> bool:
        """
        Verifica se está pronto para sincronização.

        Returns:
            True se pronto, False caso contrário.
        """
        return (
            self.sync_enabled
            and self.notion_database_id is not None
            and bool(self.notion_schema)
        )

    def get_database_id(self) -> str | None:
        """
        Retorna o ID do database como string.

        Returns:
            ID do database ou None.
        """
        return str(self.notion_database_id) if self.notion_database_id else None

    def set_database(self, database_id: str, schema: dict) -> None:
        """
        Define o database e schema.

        Args:
            database_id: ID do database no Notion.
            schema: Schema das propriedades.
        """
        self.notion_database_id = database_id
        self.notion_schema = schema
        self.save()


class NotionObjectMapping(models.Model):
    """
    Mapeamento entre objetos Django e páginas Notion.

    Mantém a correlação entre registros Django e suas
    respectivas páginas no Notion, facilitando sincronizações.
    """

    content_type: models.ForeignKey = models.ForeignKey(
        "contenttypes.ContentType",
        on_delete=models.CASCADE,
        help_text="Tipo do objeto Django"
    )

    object_id: models.PositiveIntegerField = models.PositiveIntegerField(
        help_text="ID do objeto Django"
    )

    django_model: models.CharField = models.CharField(
        max_length=100,
        help_text="Model Django (app.Model)"
    )

    external_id: models.CharField = models.CharField(
        max_length=100,
        null=True,
        blank=True,
        help_text="ID da página no Notion"
    )

    external_url: models.URLField = models.URLField(
        max_length=500,
        null=True,
        blank=True,
        help_text="URL da página no Notion"
    )

    last_sync: models.DateTimeField = models.DateTimeField(
        null=True,
        blank=True,
        help_text="Data da última sincronização"
    )

    sync_status: models.CharField = models.CharField(
        max_length=20,
        choices=[
            ("pending", "Pendente"),
            ("synced", "Sincronizado"),
            ("error", "Erro"),
        ],
        default="pending",
        help_text="Status da sincronização"
    )

    sync_error: models.TextField = models.TextField(
        null=True,
        blank=True,
        help_text="Mensagem de erro (se aplicável)"
    )

    sync_metadata: models.JSONField = models.JSONField(
        default=dict,
        blank=True,
        help_text="Metadados da sincronização"
    )

    created_at: models.DateTimeField = models.DateTimeField(
        auto_now_add=True,
        help_text="Data de criação"
    )

    updated_at: models.DateTimeField = models.DateTimeField(
        auto_now=True,
        help_text="Data da última atualização"
    )

    class Meta:
        verbose_name = "Mapeamento de Objeto Notion"
        verbose_name_plural = "Mapeamentos de Objetos Notion"
        ordering = ["-updated_at"]
        db_table = "notion_object_mapping"
        unique_together = [["content_type", "object_id"]]
        indexes = [
            models.Index(fields=["external_id"]),
            models.Index(fields=["sync_status"]),
            models.Index(fields=["last_sync"]),
            models.Index(fields=["django_model"]),
        ]

    def __str__(self) -> str:
        return f"{self.django_model}#{self.object_id} → {self.external_id or 'Pendente'}"

    def get_by_external_id(
        self,
        external_id: str,
        model_name: str | None = None
    ) -> "NotionObjectMapping | None":
        """
        Busca mapeamento por external_id.

        Args:
            external_id: ID externo no Notion.
            model_name: Nome do model (opcional).

        Returns:
            Instância de NotionObjectMapping ou None.
        """
        query = self.__class__.objects.filter(external_id=external_id)
        if model_name:
            query = query.filter(django_model=model_name)
        return query.first()


# Managers Customizados
class ContatoSyncManager(models.Manager["ContatoSync"]):
    """Manager customizado para ContatoSync."""

    def pending_sync(self) -> models.QuerySet["ContatoSync"]:
        """Contatos pendentes de sincronização."""
        return self.filter(
            models.Q(external_id__isnull=True) |
            models.Q(last_sync__lt=timezone.now() - timezone.timedelta(hours=1))
        ).filter(is_active=True)

    def with_sync_errors(self) -> models.QuerySet["ContatoSync"]:
        """Contatos com erros de sincronização."""
        return self.filter(
            sync_errors__gt=0,
            last_error__isnull=False
        )

    def needs_sync(self) -> models.QuerySet["ContatoSync"]:
        """Contatos que precisam ser sincronizados."""
        return self.filter(needs_sync=True, is_active=True)


class ContatoSync(models.Model):
    """
    Shadow model para sincronização de Contatos com Notion.

    Mantém metadados e estado de sincronização para cada
    contato do sistema principal.
    """

    contato: models.OneToOneField = models.OneToOneField(
        "clientes.Contato",
        on_delete=models.CASCADE,
        related_name="sync_metadata",
        help_text="Contato original do sistema"
    )

    external_id: models.CharField = models.CharField(
        max_length=100,
        null=True,
        blank=True,
        help_text="ID da página no Notion"
    )

    last_sync: models.DateTimeField = models.DateTimeField(
        null=True,
        blank=True,
        help_text="Data da última sincronização"
    )

    sync_errors: models.PositiveIntegerField = models.PositiveIntegerField(
        default=0,
        help_text="Número de erros de sincronização"
    )

    last_error: models.TextField = models.TextField(
        null=True,
        blank=True,
        help_text="Último erro ocorrido"
    )

    needs_sync: models.BooleanField = models.BooleanField(
        default=True,
        help_text="Se precisa ser sincronizado"
    )

    is_active: models.BooleanField = models.BooleanField(
        default=True,
        help_text="Se está ativo para sincronização"
    )

    created_at: models.DateTimeField = models.DateTimeField(
        auto_now_add=True,
        help_text="Data de criação"
    )

    updated_at: models.DateTimeField = models.DateTimeField(
        auto_now=True,
        help_text="Data da última atualização"
    )

    class Meta:
        verbose_name = "Sincronização de Contato"
        verbose_name_plural = "Sincronizações de Contatos"
        ordering = ["-updated_at"]
        db_table = "notion_sync_contato"
        indexes = [
            models.Index(fields=["external_id"]),
            models.Index(fields=["last_sync"]),
            models.Index(fields=["sync_errors"]),
            models.Index(fields=["needs_sync"]),
            models.Index(fields=["is_active"]),
        ]

    objects = ContatoSyncManager()

    def __str__(self) -> str:
        contato_nome = self.contato.nome_contato or "Sem nome"
        return f"Contato: {contato_nome} ({self.contato.telefone})"

    def prepare_notion_data(self) -> dict:
        """
        Prepara dados do contato para envio ao Notion.

        Returns:
            Dicionário com dados formatados para Notion.
        """
        try:
            # Nome do contato
            nome = self._format_name(self.contato.nome_contato)

            # Telefone formatado
            telefone = self._format_phone(self.contato.telefone)

            # Verificar se é contato principal
            is_principal = self._is_principal_contact()

            data = {
                "Nome": {
                    "title": [{"text": {"content": nome}}]
                },
                "Telefone": {
                    "phone_number": telefone
                },
                "Email": {
                    "email": self.contato.email or ""
                },
                "Principal": {
                    "checkbox": is_principal
                },
                "ID Django": {
                    "number": self.contato.id
                },
                "Data Criação": {
                    "date": {
                        "start": self.contato.created_at.isoformat() if self.contato.created_at else None
                    }
                }
            }

            # Adicionar cliente se existir
            if self.contato.cliente:
                cliente_sync = getattr(self.contato.cliente, 'sync_metadata', None)
                if cliente_sync and cliente_sync.external_id:
                    data["Cliente"] = {
                        "relation": [{"id": cliente_sync.external_id}]
                    }

            return data

        except Exception as e:
            # Fallback em caso de erro
            return self._prepare_notion_data_fallback(e)

    def _prepare_notion_data_fallback(self, error: Exception) -> dict:
        """
        Prepara dados básicos em caso de erro.

        Args:
            error: Exceção ocorrida.

        Returns:
            Dicionário com dados mínimos.
        """
        return {
            "Nome": {
                "title": [{"text": {"content": f"Erro: {str(error)}"}}]
            },
            "Telefone": {
                "phone_number": self.contato.telefone or ""
            },
            "Email": {
                "email": self.contato.email or ""
            },
            "ID Django": {
                "number": self.contato.id
            },
            "Erro": {
                "rich_text": [{"text": {"content": str(error)}}]
            }
        }

    def _format_name(self, nome: str | None) -> str:
        """
        Formata nome do contato.

        Args:
            nome: Nome original.

        Returns:
            Nome formatado.
        """
        if not nome:
            return f"Contato #{self.contato.id}"

        # Remover caracteres especiais excessivos
        nome_limpo = re.sub(r'[^\w\s\-\.]', '', nome)
        return nome_limpo.strip()[:100]  # Limite do Notion

    def _format_phone(self, telefone: str | None) -> str:
        """
        Formata número de telefone.

        Args:
            telefone: Telefone original.

        Returns:
            Telefone formatado ou vazio.
        """
        if not telefone:
            return ""

        # Remover caracteres não numéricos
        numeros = re.sub(r'[^\d]', '', telefone)

        # Formatar para Brasil
        if len(numeros) == 11:
            return f"+55 {numeros[:2]} {numeros[2:7]}-{numeros[7:]}"
        elif len(numeros) == 10:
            return f"+55 {numeros[:2]} {numeros[2:6]}-{numeros[6:]}"
        else:
            return telefone

    def _is_principal_contact(self) -> bool:
        """
        Verifica se é o contato principal do cliente.

        Returns:
            True se for principal, False caso contrário.
        """
        if not self.contato.cliente:
            return False

        # Contato principal é geralmente o primeiro criado
        primeiro_contato = self.contato.cliente.contatos.order_by('created_at').first()
        return primeiro_contato and primeiro_contato.id == self.contato.id

    def needs_sync(self) -> bool:
        """
        Verifica se o contato precisa ser sincronizado.

        Returns:
            True se precisa sincronizar, False caso contrário.
        """
        if not self.external_id:
            return True

        # Se houve mudança no contato
        if self.contato.updated_at and self.last_sync:
            if self.contato.updated_at > self.last_sync:
                return True

        return False

    def mark_as_synced(self, external_id: str) -> None:
        """
        Marca contato como sincronizado.

        Args:
            external_id: ID da página no Notion.
        """
        self.external_id = external_id
        self.last_sync = timezone.now()
        self.sync_errors = 0
        self.last_error = None
        self.needs_sync = False
        self.save(update_fields=[
            'external_id', 'last_sync', 'sync_errors',
            'last_error', 'needs_sync'
        ])

    def mark_as_failed(self, error_message: str) -> None:
        """
        Marca sincronização como falha.

        Args:
            error_message: Mensagem de erro.
        """
        self.sync_errors = models.F('sync_errors') + 1
        self.last_error = error_message
        self.needs_sync = True
        self.save(update_fields=['sync_errors', 'last_error', 'needs_sync'])

    @property
    def is_synced(self) -> bool:
        """Retorna se está sincronizado."""
        return bool(self.external_id and self.last_sync)

    @property
    def sync_age_hours(self) -> int:
        """Idade da última sincronização em horas."""
        if not self.last_sync:
            return 999

        diff = timezone.now() - self.last_sync
        return int(diff.total_seconds() / 3600)

    @property
    def has_sync_errors(self) -> bool:
        """Retorna se tem erros de sincronização."""
        return self.sync_errors > 0

    @property
    def notion_url(self) -> str:
        """URL da página no Notion."""
        if not self.external_id:
            return ""

        import os
        database_id = os.getenv('NOTION_DATABASE_CLIENTE_ID', '')
        if not database_id:
            return ""

        return f"https://www.notion.so/{database_id}?p={self.external_id.replace('-', '')}"


class ClienteSyncManager(models.Manager["ClienteSync"]):
    """Manager customizado para ClienteSync."""

    def pending_sync(self) -> models.QuerySet["ClienteSync"]:
        """Clientes pendentes de sincronização."""
        return self.filter(
            models.Q(external_id__isnull=True) |
            models.Q(last_sync__lt=timezone.now() - timezone.timedelta(hours=1))
        ).filter(is_active=True)

    def with_sync_errors(self) -> models.QuerySet["ClienteSync"]:
        """Clientes com erros de sincronização."""
        return self.filter(
            sync_errors__gt=0,
            last_error__isnull=False
        )

    def needs_sync(self) -> models.QuerySet["ClienteSync"]:
        """Clientes que precisam ser sincronizados."""
        return self.filter(needs_sync=True, is_active=True)


class ClienteSync(models.Model):
    """
    Shadow model para sincronização de Clientes com Notion.

    Mantém metadados e estado de sincronização para cada
    cliente do sistema principal.
    """

    cliente: models.OneToOneField = models.OneToOneField(
        "clientes.Cliente",
        on_delete=models.CASCADE,
        related_name="sync_metadata",
        help_text="Cliente original do sistema"
    )

    external_id: models.CharField = models.CharField(
        max_length=100,
        null=True,
        blank=True,
        help_text="ID da página no Notion"
    )

    last_sync: models.DateTimeField = models.DateTimeField(
        null=True,
        blank=True,
        help_text="Data da última sincronização"
    )

    sync_errors: models.PositiveIntegerField = models.PositiveIntegerField(
        default=0,
        help_text="Número de erros de sincronização"
    )

    last_error: models.TextField = models.TextField(
        null=True,
        blank=True,
        help_text="Último erro ocorrido"
    )

    needs_sync: models.BooleanField = models.BooleanField(
        default=True,
        help_text="Se precisa ser sincronizado"
    )

    is_active: models.BooleanField = models.BooleanField(
        default=True,
        help_text="Se está ativo para sincronização"
    )

    notion_properties: models.JSONField = models.JSONField(
        default=dict,
        blank=True,
        help_text="Propriedades enviadas ao Notion"
    )

    created_at: models.DateTimeField = models.DateTimeField(
        auto_now_add=True,
        help_text="Data de criação"
    )

    updated_at: models.DateTimeField = models.DateTimeField(
        auto_now=True,
        help_text="Data da última atualização"
    )

    class Meta:
        verbose_name = "Sincronização de Cliente"
        verbose_name_plural = "Sincronizações de Clientes"
        ordering = ["-updated_at"]
        db_table = "notion_sync_cliente"
        indexes = [
            models.Index(fields=["external_id"]),
            models.Index(fields=["last_sync"]),
            models.Index(fields=["sync_errors"]),
            models.Index(fields=["needs_sync"]),
            models.Index(fields=["is_active"]),
        ]

    objects = ClienteSyncManager()

    def __str__(self) -> str:
        return f"Cliente: {self.cliente.nome_fantasia}"

    def prepare_notion_data(self) -> dict:
        """
        Prepara dados do cliente para envio ao Notion.

        Returns:
            Dicionário com dados formatados para Notion.
        """
        try:
            data = {
                "Nome Fantasia": {
                    "title": [{"text": {"content": self.cliente.nome_fantasia}}]
                },
                "Razão Social": {
                    "rich_text": [{"text": {"content": self.cliente.razao_social or ""}}]
                },
                "Tipo": {
                    "select": {"name": self.cliente.get_tipo_display()}
                },
                "ID Django": {
                    "number": self.cliente.id
                },
                "Data Criação": {
                    "date": {
                        "start": self.cliente.created_at.isoformat() if self.cliente.created_at else None
                    }
                },
                "Última Atualização": {
                    "date": {
                        "start": self.cliente.updated_at.isoformat() if self.cliente.updated_at else None
                    }
                }
            }

            # Adicionar CNPJ se for pessoa jurídica
            if self.cliente.tipo == 'juridica' and self.cliente.cnpj:
                data["CNPJ"] = {
                    "rich_text": [{"text": {"content": self._format_cnpj(self.cliente.cnpj)}}]
                }

            # Adicionar CPF se for pessoa física
            if self.cliente.tipo == 'fisica' and self.cliente.cpf:
                data["CPF"] = {
                    "rich_text": [{"text": {"content": self.cliente.cpf}}]
                }

            # Adicionar telefones
            telefones = []
            if self.cliente.telefone_comercial:
                telefones.append(self._format_phone(self.cliente.telefone_comercial))
            if self.cliente.telefone_celular:
                telefones.append(self._format_phone(self.cliente.telefone_celular))

            if telefones:
                data["Telefones"] = {
                    "rich_text": [{"text": {"content": ", ".join(telefones)}}]
                }

            # Adicionar contatos relacionados
            contatos_relacionados = []
            contato_syncs = ContatoSync.objects.filter(
                contato__cliente=self.cliente,
                external_id__isnull=False
            )

            for contato_sync in contato_syncs:
                contatos_relacionados.append({
                    "id": contato_sync.external_id
                })

            if contatos_relacionados:
                data["Contatos"] = {
                    "relation": contatos_relacionados
                }

            self.notion_properties = data
            return data

        except Exception as e:
            # Fallback em caso de erro
            return self._prepare_notion_data_fallback(e)

    def _prepare_notion_data_fallback(self, error: Exception) -> dict:
        """
        Prepara dados básicos em caso de erro.

        Args:
            error: Exceção ocorrida.

        Returns:
            Dicionário com dados mínimos.
        """
        return {
            "Nome Fantasia": {
                "title": [{"text": {"content": self.cliente.nome_fantasia}}]
            },
            "ID Django": {
                "number": self.cliente.id
            },
            "Erro": {
                "rich_text": [{"text": {"content": str(error)}}]
            }
        }

    def _format_cnpj(self, cnpj: str) -> str:
        """
        Formata CNPJ.

        Args:
            cnpj: CNPJ original.

        Returns:
            CNPJ formatado.
        """
        # Remover caracteres não numéricos
        numeros = re.sub(r'[^\d]', '', cnpj)

        # Formatar CNPJ (XX.XXX.XXX/XXXX-XX)
        if len(numeros) == 14:
            return f"{numeros[:2]}.{numeros[2:5]}.{numeros[5:8]}/{numeros[8:12]}-{numeros[12:]}"
        else:
            return cnpj

    def _format_phone(self, telefone: str | None) -> str:
        """
        Formata número de telefone.

        Args:
            telefone: Telefone original.

        Returns:
            Telefone formatado ou vazio.
        """
        if not telefone:
            return ""

        # Remover caracteres não numéricos
        numeros = re.sub(r'[^\d]', '', telefone)

        # Formatar para Brasil
        if len(numeros) == 11:
            return f"{numeros[:2]} {numeros[2:7]}-{numeros[7:]}"
        elif len(numeros) == 10:
            return f"{numeros[:2]} {numeros[2:6]}-{numeros[6:]}"
        else:
            return telefone

    def needs_sync(self) -> bool:
        """
        Verifica se o cliente precisa ser sincronizado.

        Returns:
            True se precisa sincronizar, False caso contrário.
        """
        if not self.external_id:
            return True

        # Se houve mudança no cliente
        if self.cliente.updated_at and self.last_sync:
            if self.cliente.updated_at > self.last_sync:
                return True

        return False

    def mark_as_synced(self, external_id: str) -> None:
        """
        Marca cliente como sincronizado.

        Args:
            external_id: ID da página no Notion.
        """
        self.external_id = external_id
        self.last_sync = timezone.now()
        self.sync_errors = 0
        self.last_error = None
        self.needs_sync = False
        self.save(update_fields=[
            'external_id', 'last_sync', 'sync_errors',
            'last_error', 'needs_sync'
        ])

    def mark_as_failed(self, error_message: str) -> None:
        """
        Marca sincronização como falha.

        Args:
            error_message: Mensagem de erro.
        """
        self.sync_errors = models.F('sync_errors') + 1
        self.last_error = error_message
        self.needs_sync = True
        self.save(update_fields=['sync_errors', 'last_error', 'needs_sync'])

    @property
    def is_synced(self) -> bool:
        """Retorna se está sincronizado."""
        return bool(self.external_id and self.last_sync)

    @property
    def sync_age_hours(self) -> int:
        """Idade da última sincronização em horas."""
        if not self.last_sync:
            return 999

        diff = timezone.now() - self.last_sync
        return int(diff.total_seconds() / 3600)

    @property
    def has_sync_errors(self) -> bool:
        """Retorna se tem erros de sincronização."""
        return self.sync_errors > 0


class DepartamentoSync(models.Model):
    """
    Shadow model para sincronização de Departamentos com Notion.
    """

    departamento: models.OneToOneField = models.OneToOneField(
        "central_atendimento.Departamento",
        on_delete=models.CASCADE,
        related_name="sync_metadata",
        help_text="Departamento original do sistema"
    )

    external_id: models.CharField = models.CharField(
        max_length=100,
        null=True,
        blank=True,
        help_text="ID da página no Notion"
    )

    last_sync: models.DateTimeField = models.DateTimeField(
        null=True,
        blank=True,
        help_text="Data da última sincronização"
    )

    sync_errors: models.PositiveIntegerField = models.PositiveIntegerField(
        default=0,
        help_text="Número de erros de sincronização"
    )

    last_error: models.TextField = models.TextField(
        null=True,
        blank=True,
        help_text="Último erro ocorrido"
    )

    needs_sync: models.BooleanField = models.BooleanField(
        default=True,
        help_text="Se precisa ser sincronizado"
    )

    is_active: models.BooleanField = models.BooleanField(
        default=True,
        help_text="Se está ativo para sincronização"
    )

    created_at: models.DateTimeField = models.DateTimeField(
        auto_now_add=True,
        help_text="Data de criação"
    )

    updated_at: models.DateTimeField = models.DateTimeField(
        auto_now=True,
        help_text="Data da última atualização"
    )

    class Meta:
        verbose_name = "Sincronização de Departamento"
        verbose_name_plural = "Sincronizações de Departamentos"
        ordering = ["-updated_at"]
        db_table = "notion_sync_departamento"
        indexes = [
            models.Index(fields=["external_id"]),
            models.Index(fields=["last_sync"]),
            models.Index(fields=["sync_errors"]),
            models.Index(fields=["needs_sync"]),
            models.Index(fields=["is_active"]),
        ]

    def __str__(self) -> str:
        return f"Departamento: {self.departamento.nome}"


