# URL do servidor da Evolution API (ex: http://seu_ip:8080 ou https://sua-api.com)
EVO_URL=http://SEU_IP_AQUI:8080

# Chave de acesso da API (Global API Key disponível nas configurações da Evolution)
EVO_API_KEY=sua_api_key_global_aqui

# Nome exato da instância que está conectada no painel
INSTANCE_NAME=nome_da_sua_instancia

# ID do grupo para enviar a mensagem de teste (pegue listando com o outro script)
ID_GRUPO=1234567890@g.us
